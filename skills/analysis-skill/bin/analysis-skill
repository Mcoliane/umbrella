#!/usr/bin/env python3
"""Umbrella analysis / review skill.

A READ-ONLY, scope-enforced agent that reads a codebase or set of files and produces a
STRUCTURED, EVIDENCE-BASED REVIEW REPORT — architecture, code quality, security, or an
adversarial critique, as the task asks. Unlike the workspace skill (which finds and
summarizes files) or the code agent (which builds and edits), this shop's job is to
ANALYZE and REPORT: concrete findings, each grounded in a real file/path, organized for
the reader. Its output IS the answer — so the mayor has real substance to hand back.

The scope-enforced, read-only file tools come from the shared services.skill_fs module
(one audited implementation), not reimplemented here. Reads a job JSON on stdin
({"invocation":{"inputs":{...}}}); emits a JSON report.
"""
from __future__ import annotations

import json
import os
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

# Shared, audited file tools (scope enforcement + secret guard) live in one module so
# skills don't reimplement the security-critical path. Reachable via UMBRELLA_ROOT (with
# a parents[3] fallback) exactly like the code agent imports services.environment.
_ROOT = Path(os.environ.get("UMBRELLA_ROOT") or Path(__file__).resolve().parents[3])
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))
from services.skill_fs import ScopedFiles, READ_TOOLS, safe_roots, OBS_CAP, _fn  # noqa: E402

MODEL_TIMEOUT = 300
REPORT_CAP = 60000

# Path-like tokens (~/..., /abs/..., ./rel) so a review that names its target inline in the
# task text still scopes correctly when the caller forgot to set `target`.
_PATH_RE = re.compile(r"(?:~|\.{0,2}/)[^\s\"'`]+")


def _paths_in_text(text: str) -> str:
    """Best-effort recovery of path-like tokens from the task text, space-joined for
    safe_roots to validate (only existing paths survive). '' when none look like paths."""
    hits = []
    for m in _PATH_RE.findall(str(text or "")):
        tok = m.rstrip(".,:;)]}")
        if len(tok) > 2:
            hits.append(tok)
    return " ".join(hits)


def _read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def load_model(root: Path) -> dict:
    runtime = root / "control-plane" / "runtime"
    cfg = _read_json(runtime / "model-broker.json")
    secrets = _read_json(runtime / "model-broker.secrets.json")
    routing = cfg.get("routing") if isinstance(cfg.get("routing"), dict) else {}
    conns = cfg.get("connections") if isinstance(cfg.get("connections"), dict) else {}
    cid = "code" if "code" in conns else (str(routing.get("defaultConnectionId", "")).strip() or "default")
    conn = conns.get(cid) if isinstance(conns.get(cid), dict) else {}
    sconn = ((secrets.get("connections") or {}).get(cid) or {}) if isinstance(secrets, dict) else {}
    return {
        "baseUrl": str(conn.get("baseUrl", "")).strip(),
        "model": str(conn.get("defaultModel", "")).strip(),
        "apiKey": str(sconn.get("apiKey", "")).strip(),
    }


def chat_raw(model_cfg: dict, messages: list, tools: list | None = None, temperature: float = 0.1) -> dict:
    payload = {"model": model_cfg["model"], "messages": messages, "temperature": temperature, "max_tokens": 8192}
    if tools:
        payload["tools"] = tools
        payload["tool_choice"] = "auto"
    body = json.dumps(payload).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    if model_cfg["apiKey"]:
        headers["Authorization"] = f"Bearer {model_cfg['apiKey']}"
    url = model_cfg["baseUrl"].rstrip("/") + "/chat/completions"
    for attempt in range(6):
        try:
            req = urllib.request.Request(url, data=body, method="POST", headers=headers)
            with urllib.request.urlopen(req, timeout=MODEL_TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            return ((data.get("choices") or [{}])[0].get("message")) or {}
        except urllib.error.HTTPError as ex:
            if ex.code not in (429, 500, 502, 503, 504) or attempt == 3:
                raise
        except urllib.error.URLError:
            if attempt == 3:
                raise
    return {}


_FINISH_TOOL = _fn(
    "finish",
    "Finish with the structured review REPORT: a short overall assessment, then concrete findings — each with "
    "a title, the specific file path(s) it's grounded in, why it matters, and (for problems) a suggested fix.",
    {"report": {"type": "string"}}, ["report"])

SYSTEM = """You are an analysis & review agent inside Umbrella. Your job is to READ a codebase or set of files
and produce a STRUCTURED, EVIDENCE-BASED REVIEW — you never change anything. Depending on the task this may be
an architecture review, a code-quality review, a security/adversarial review, or a targeted analysis.

How to work:
1. Use `find` and `list_dir` to map the target and locate the relevant files under the allowed roots.
2. Use `read_file` to actually read the code/files you're reviewing — base EVERY finding on what you read.
3. Be thorough but focused: sample the important files (entry points, core modules, config, whatever the task
   points at). You don't need to read everything, but read enough to support real findings.
4. When the task is adversarial ("adversarially review", "find weaknesses", "red-team"), actively HUNT for
   problems: security holes, missing checks, fragile assumptions, unhandled failures, design smells.
5. Call `finish` with a STRUCTURED REPORT: a short overall assessment, then concrete findings — each with a
   short title, the specific file path(s) it's grounded in, why it matters, and (for problems) a suggested
   fix. Prefer specifics over generalities.

Hard rules:
- Stay within the allowed roots; if a path is refused as out of scope, say so — do not work around it.
- Never read or surface secrets (private keys, credentials, .env values) — refuse those files.
- This is READ-ONLY. You never write, move, or delete anything.
- Ground EVERY finding in a file you actually read. Do NOT invent issues or claim to have read files you
  didn't. If you couldn't find enough to review, say so plainly instead of padding the report."""


def main() -> int:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        print(json.dumps({"ok": False, "error": "invalid JSON on stdin"}))
        return 1
    inputs = (((payload.get("invocation") or {}).get("inputs")) or {}) if isinstance(payload, dict) else {}
    task = str(inputs.get("task", "")).strip()
    if not task:
        print(json.dumps({"ok": False, "error": "'task' is required"}))
        return 1
    # Scope is REQUIRED. A review runs ONLY inside an explicitly named folder/project — an
    # unscoped review must never silently crawl the whole home tree (Desktop/Documents/
    # Downloads). Prefer the caller's target/roots; else try to recover a path from the task
    # text; else ask which folder rather than scanning everything.
    roots = safe_roots(str(inputs.get("roots", "") or inputs.get("target", "")), fallback_broad=False)
    if not roots:
        roots = safe_roots(_paths_in_text(task), fallback_broad=False)
    if not roots:
        print(json.dumps({
            "ok": True, "verified": False, "filesRead": [], "iterations": 0,
            "summary": ("I need a folder to review. Tell me which project or path to look at "
                        "(for example ~/Desktop/Emcom_umbrella0.4) and I'll scope the review to it — "
                        "I won't scan your whole home folder by default."),
            "report": ("No review performed: no target folder was given. Re-run with a specific path in "
                       "`target` (e.g. ~/Desktop/Emcom_umbrella0.4) to scope the review to that project."),
        }))
        return 0
    max_iters = max(6, min(int(inputs.get("maxIterations", 30) or 30), 60))

    root = Path(os.environ.get("UMBRELLA_ROOT") or Path(__file__).resolve().parents[3])
    model_cfg = load_model(root)
    if not model_cfg["baseUrl"] or not model_cfg["model"]:
        print(json.dumps({"ok": False, "error": "no model connection configured for the analysis skill"}))
        return 1

    eng = ScopedFiles(roots)
    tools = READ_TOOLS + [_FINISH_TOOL]
    context = (f"REVIEW TASK: {task}\nALLOWED ROOTS: {[str(r) for r in roots]}\n"
               "Map the target, read the relevant files, then finish with a structured, evidence-based review "
               "report. Ground every finding in a file you actually read.")
    messages = [{"role": "system", "content": SYSTEM}, {"role": "user", "content": context}]
    iters, finished, report, no_tool = 0, False, "", 0

    while iters < max_iters and not finished:
        iters += 1
        try:
            msg = chat_raw(model_cfg, messages, tools=tools)
        except Exception as ex:  # noqa: BLE001
            report = f"model error after {iters} step(s): {type(ex).__name__}: {ex}"
            break
        tool_calls = msg.get("tool_calls") or []
        assistant = {"role": "assistant", "content": msg.get("content")}
        if tool_calls:
            assistant["tool_calls"] = tool_calls
        messages.append(assistant)
        if not tool_calls:
            no_tool += 1
            if no_tool >= 2:
                report = str(msg.get("content") or "").strip() or "stopped without producing a review"
                break
            messages.append({"role": "user", "content": "Use a tool to read the files, or call finish with your report."})
            continue
        no_tool = 0
        for tc in tool_calls:
            fn = tc.get("function") if isinstance(tc.get("function"), dict) else {}
            name = str(fn.get("name", "")).strip()
            try:
                args = json.loads(fn.get("arguments") or "{}")
            except (ValueError, TypeError):
                args = {}
            if name == "finish":
                report, finished = str(args.get("report", "")).strip(), True
                result = "acknowledged"
            elif name == "list_dir":
                result = eng.list_dir(args if isinstance(args, dict) else {})
            elif name == "find":
                result = eng.find(args if isinstance(args, dict) else {})
            elif name == "read_file":
                result = eng.read_file(args if isinstance(args, dict) else {})
            else:
                result = f"unknown tool: {name}"
            messages.append({"role": "tool", "tool_call_id": str(tc.get("id") or ""), "content": str(result)[:OBS_CAP]})
        if finished:
            break

    # If we have read files but no report text (ran out of steps, or finish was called
    # with an empty arg), force one final synthesis (no tools) so we return a real review.
    if not report.strip() and eng.files_read:
        try:
            messages.append({"role": "user", "content":
                "Stop reading. Based on everything you've read, write the structured review report NOW: a short "
                "overall assessment, then concrete findings, each citing the file path(s). Report prose only."})
            final = chat_raw(model_cfg, messages, tools=None)
            report = str(final.get("content") or "").strip()
            if report:
                finished = True
        except Exception:  # noqa: BLE001
            pass
    # A review with no files read and no report is not a real answer — say so honestly
    # rather than emitting an empty success (the mayor debrief refuses hollow success).
    if not report.strip():
        report = "No review produced — I couldn't read enough in the allowed locations to analyze."
    # The report IS the substance the mayor hands back, so carry it in `summary` (not a
    # 400-char stub) so reconciliation surfaces real findings rather than a status line.
    print(json.dumps({
        "ok": True,
        "summary": report[:REPORT_CAP],
        "report": report,
        "filesRead": eng.files_read,
        "iterations": iters,
        "verified": finished and bool(eng.files_read),
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
