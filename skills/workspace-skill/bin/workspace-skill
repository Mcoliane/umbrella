#!/usr/bin/env python3
"""Umbrella workspace / files skill.

A scope-enforced agent for the user's local files: find files by name/content, read and
summarize them, and — when write access is granted — create, edit, and reorganize them.
The model is the reasoning glue over real file tools, NOT raw filesystem access.

The scope-enforced file tools (read + write) come from the shared services.skill_fs
module — one audited implementation of the scope/secret-guard/read/write path, not
reimplemented here. Guardrails: scoped to safe roots, refuses secrets/hidden files,
read-only unless allowWrite is set, no delete, capped reads.

Reads a job JSON on stdin ({"invocation":{"inputs":{...}}}); emits a JSON answer.
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

# Shared, audited file tools (scope enforcement + secret guard) live in one module so
# skills don't reimplement the security-critical path. Reachable via UMBRELLA_ROOT (with
# a parents[3] fallback) exactly like the code agent imports services.environment.
_ROOT = Path(os.environ.get("UMBRELLA_ROOT") or Path(__file__).resolve().parents[3])
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))
from services.skill_fs import ScopedFiles, READ_TOOLS, WRITE_TOOLS, safe_roots, OBS_CAP, _fn  # noqa: E402

MODEL_TIMEOUT = 300


def _read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def load_model(root: Path) -> dict:
    runtime = root / "control-plane" / "runtime"
    cfg = _read_json(runtime / "model-broker.json")
    secrets = _read_json(runtime / "model-broker.secrets.json")
    routing = cfg.get("routing") if isinstance(cfg.get("routing"), dict) else {}
    conns = cfg.get("connections") if isinstance(cfg.get("connections"), dict) else {}
    cid = "code" if "code" in conns else (str(routing.get("defaultConnectionId", "")).strip() or "default")
    conn = conns.get(cid) if isinstance(conns.get(cid), dict) else {}
    sconn = ((secrets.get("connections") or {}).get(cid) or {}) if isinstance(secrets, dict) else {}
    return {
        "baseUrl": str(conn.get("baseUrl", "")).strip(),
        "model": str(conn.get("defaultModel", "")).strip(),
        "apiKey": str(sconn.get("apiKey", "")).strip(),
    }


def chat_raw(model_cfg: dict, messages: list, tools: list | None = None, temperature: float = 0.1) -> dict:
    payload = {"model": model_cfg["model"], "messages": messages, "temperature": temperature, "max_tokens": 8192}
    if tools:
        payload["tools"] = tools
        payload["tool_choice"] = "auto"
    body = json.dumps(payload).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    if model_cfg["apiKey"]:
        headers["Authorization"] = f"Bearer {model_cfg['apiKey']}"
    url = model_cfg["baseUrl"].rstrip("/") + "/chat/completions"
    for attempt in range(6):
        try:
            req = urllib.request.Request(url, data=body, method="POST", headers=headers)
            with urllib.request.urlopen(req, timeout=MODEL_TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            return ((data.get("choices") or [{}])[0].get("message")) or {}
        except urllib.error.HTTPError as ex:
            if ex.code not in (429, 500, 502, 503, 504) or attempt == 3:
                raise
        except urllib.error.URLError:
            if attempt == 3:
                raise
    return {}


_FINISH_TOOL = _fn("finish", "Finish with a clear answer/summary of what you found or did — cite the file path(s).",
                   {"answer": {"type": "string"}}, ["answer"])

SYSTEM = """You are a workspace/files agent inside Umbrella. You help with the user's local files: finding, reading,
and summarizing them, and — when write access is granted for the task — creating, editing, and reorganizing them.
Work like a careful assistant:
1. Use `find` to locate the relevant file(s) by name and/or content under the allowed roots.
2. Use `list_dir` to orient yourself in a folder when you're unsure.
3. Use `read_file` to read what you found.
4. If you have write tools and the task calls for it, use `write_file` / `move_file` to make ONLY the change the
   task asks for, and confirm the target path is what the user intends before overwriting an existing file.
5. Call `finish` with a clear answer grounded in what you actually did/read — cite the file path(s).

Hard rules:
- Stay within the allowed roots. If a path is refused as out of scope, do not try to work around it — say so.
- Never read, write, or surface secrets (private keys, credentials, .env values). Refuse those files.
- There is NO delete tool; you never delete anything.
- Ground your answer in reality — do not invent what a file says or claim a change you did not make."""

_READONLY_NOTE = ("\n\nThis task is READ-ONLY: you have find/list/read only. You cannot create, modify, or move "
                  "files; if the user is asking for a change, say it wasn't granted write access.")
_WRITE_NOTE = ("\n\nThis task has WRITE access: write_file and move_file are available. Create/overwrite/move files "
               "ONLY within the allowed roots and only as the task requires; prefer a new file over overwriting an "
               "existing one unless the user clearly wants the overwrite.")


def main() -> int:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        print(json.dumps({"ok": False, "error": "invalid JSON on stdin"}))
        return 1
    inputs = (((payload.get("invocation") or {}).get("inputs")) or {}) if isinstance(payload, dict) else {}
    task = str(inputs.get("task", "")).strip()
    if not task:
        print(json.dumps({"ok": False, "error": "'task' is required"}))
        return 1
    roots = safe_roots(str(inputs.get("roots", "")))
    max_iters = max(4, min(int(inputs.get("maxIterations", 24) or 24), 60))
    allow_write = bool(inputs.get("allowWrite", False))
    tools = READ_TOOLS + (WRITE_TOOLS if allow_write else []) + [_FINISH_TOOL]
    system = SYSTEM + (_WRITE_NOTE if allow_write else _READONLY_NOTE)

    root = Path(os.environ.get("UMBRELLA_ROOT") or Path(__file__).resolve().parents[3])
    model_cfg = load_model(root)
    if not model_cfg["baseUrl"] or not model_cfg["model"]:
        print(json.dumps({"ok": False, "error": "no model connection configured for the workspace skill"}))
        return 1

    eng = ScopedFiles(roots)
    context = (f"QUESTION / TASK: {task}\nALLOWED ROOTS: {[str(r) for r in roots]}\n"
               f"WRITE ACCESS: {'granted' if allow_write else 'NOT granted (read-only)'}\n"
               "Locate the relevant file(s), then answer the question or make the requested change.")
    messages = [{"role": "system", "content": system}, {"role": "user", "content": context}]
    iters, finished, answer, no_tool = 0, False, "", 0

    while iters < max_iters and not finished:
        iters += 1
        try:
            msg = chat_raw(model_cfg, messages, tools=tools)
        except Exception as ex:  # noqa: BLE001
            answer = f"model error after {iters} step(s): {type(ex).__name__}: {ex}"
            break
        tool_calls = msg.get("tool_calls") or []
        assistant = {"role": "assistant", "content": msg.get("content")}
        if tool_calls:
            assistant["tool_calls"] = tool_calls
        messages.append(assistant)
        if not tool_calls:
            no_tool += 1
            if no_tool >= 2:
                answer = str(msg.get("content") or "").strip() or "stopped without an answer"
                break
            messages.append({"role": "user", "content": "Use a tool to find/read the file, or call finish."})
            continue
        no_tool = 0
        for tc in tool_calls:
            fn = tc.get("function") if isinstance(tc.get("function"), dict) else {}
            name = str(fn.get("name", "")).strip()
            try:
                args = json.loads(fn.get("arguments") or "{}")
            except (ValueError, TypeError):
                args = {}
            if name == "finish":
                answer, finished = str(args.get("answer", "")).strip(), True
                result = "acknowledged"
            elif name == "list_dir":
                result = eng.list_dir(args if isinstance(args, dict) else {})
            elif name == "find":
                result = eng.find(args if isinstance(args, dict) else {})
            elif name == "read_file":
                result = eng.read_file(args if isinstance(args, dict) else {})
            elif name == "write_file":
                result = eng.write_file(args if isinstance(args, dict) else {}) if allow_write else "REFUSED: write access was not granted for this task."
            elif name == "move_file":
                result = eng.move_file(args if isinstance(args, dict) else {}) if allow_write else "REFUSED: write access was not granted for this task."
            else:
                result = f"unknown tool: {name}"
            messages.append({"role": "tool", "tool_call_id": str(tc.get("id") or ""), "content": str(result)[:OBS_CAP]})
        if finished:
            break

    print(json.dumps({
        "ok": True,
        "summary": (answer or "no answer")[:4000],
        "answer": answer or "I couldn't find an answer in the allowed file locations.",
        "filesRead": eng.files_read,
        "filesWritten": eng.files_written,
        "iterations": iters,
        "verified": finished,
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
